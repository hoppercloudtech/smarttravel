// ============================================================================
// SmartTravel — Prisma Schema
// Source of truth for every place page on the site. Nothing on a public page
// is computed live from external APIs — everything is read from these tables.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PlaceCategory {
  HOTEL
  RESORT
  RESTAURANT
  AIRBNB
  GUEST_HOUSE
  APARTMENT
  CAMPSITE
  ATTRACTION
}

enum PlaceStatus {
  DRAFT
  PUBLISHED
  NEEDS_REVIEW
  ARCHIVED
}

enum RefreshStatus {
  STABLE
  QUEUED
  IN_PROGRESS
  FAILED
}

enum ImageStatus {
  PENDING
  PARTIAL
  COMPLETE
  NONE_AVAILABLE
}

enum AdminRole {
  SUPER_ADMIN
  EDITOR
  VIEWER
}

enum IngestionRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  PARTIAL
}

// ---------------------------------------------------------------------------
// Admin / Auth
// ---------------------------------------------------------------------------

model AdminUser {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          AdminRole @default(EDITOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  placesCreated Place[]   @relation("PlaceCreatedBy")
  placesUpdated Place[]   @relation("PlaceUpdatedBy")

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Geography / taxonomy lookups — adding a new country is a data insert only
// ---------------------------------------------------------------------------

model Country {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cities    City[]
  places    Place[]

  landmarks      Landmark[]
  discoveryPages DiscoveryPage[]

  @@map("countries")
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())

  places    Place[]
  landmarks      Landmark[]
  discoveryPages DiscoveryPage[]

  @@unique([countryId, slug])
  @@map("cities")
}

// ---------------------------------------------------------------------------
// Core entity
// ---------------------------------------------------------------------------

model Place {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  category      PlaceCategory
  status        PlaceStatus   @default(DRAFT)

  countryId     String
  country       Country       @relation(fields: [countryId], references: [id])
  cityId        String?
  city          City?         @relation(fields: [cityId], references: [id])
  district      String?

  latitude      Float?
  longitude     Float?
  address       String?
  googleMapsUrl String?

  website       String?
  phone         String?
  email         String?
  discoveryScore PlaceDiscoveryScore?

  // Free-form structured facts collected at ingestion time. Kept as JSON so
  // amenity/room-type shapes can vary by category without schema churn.
  amenities     Json?         // e.g. ["Free WiFi", "Pool", "Airport Shuttle"]
  roomTypes     Json?         // e.g. [{ "name": "Deluxe King", "notes": "..." }]

  description   String?       // raw / source description, NOT the AI summary
  priceLevel    Int?          // 1-4, optional signal only

  source        String?       // where this record was ingested from
  sourceRef     String?       // external id/url for de-duplication

  refreshStatus RefreshStatus @default(STABLE)
  imageStatus   ImageStatus   @default(PENDING)
  lastSeoHealthCheckedAt DateTime? // drives the health-check batch's "oldest first" ordering — see jobs/seoIntelligence.ts

  // Google Places identity — see lib/google/ for the compliance design.
  // Only place_id (indefinite) and coordinates (30 days) are ever persisted
  // from Google; every other Google field requires admin re-authoring
  // through the normal editor before it becomes real HorizonSpot content.
  googlePlaceId       String?   @unique
  provider String? // "google" | "geoapify" — set only for provider-discovered places; OSM/manual places leave this null
  coordinatesSource   String?   // "osm" | "google" | "manual" | "nominatim"
  coordinatesCachedAt DateTime?
  featured      Boolean       @default(false)
  viewCount     Int           @default(0)

  createdById   String?
  createdBy     AdminUser?    @relation("PlaceCreatedBy", fields: [createdById], references: [id])
  updatedById   String?
  updatedBy     AdminUser?    @relation("PlaceUpdatedBy", fields: [updatedById], references: [id])

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  media         PlaceMedia[]
  summaries     AISummary[]
  seoMeta       SEOMeta?
  faqs          PlaceFAQ[]

  nearbyFrom    NearbyRelation[] @relation("NearbyFromPlace")
  nearbyTo      NearbyRelation[] @relation("NearbyToPlace")

  searchLogs    SearchQueryLog[]
  pageViews     PageViewLog[]
  ingestionLogs IngestionLog[]
  tiktokPosts   TikTokPost[]
  googleCandidate GooglePlaceCandidate?
  seoInsights SeoInsight[]

  @@index([category, countryId, cityId])
  @@index([status])
  @@index([slug])
  @@map("places")
}

model PlaceMedia {
  id           String   @id @default(cuid())
  placeId      String
  place        Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  cloudinaryId String   // Cloudinary public_id — used for transformations & deletion
  url          String   // secure_url returned by Cloudinary
  altText      String?
  width        Int?
  height       Int?
  order        Int      @default(0)
  isHero       Boolean  @default(false)

  license      String?  // e.g. "business-submitted", "wikimedia-cc-by-sa", "official-media"
  sourceUrl    String?  // attribution / provenance

  createdAt    DateTime @default(now())

  @@index([placeId, order])
  @@map("place_media")
}

// Versioned AI summaries. `isCurrent` marks the one actually rendered on the
// public page — older versions are kept for audit/rollback, never deleted.
model AISummary {
  id           String   @id @default(cuid())
  placeId      String
  place        Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  content      String   @db.Text
  faqJson      Json?    // [{ "question": "...", "answer": "..." }]

  model        String
  promptTokens Int      @default(0)
  outputTokens Int      @default(0)
  estCostUsd   Float    @default(0)

  isCurrent    Boolean  @default(true)
  generatedAt  DateTime @default(now())
  triggeredBy  String   // "ingestion" | "manual-regenerate" | "scheduled-refresh"

  @@index([placeId, isCurrent])
  @@map("ai_summaries")
}

model PlaceFAQ {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  order     Int      @default(0)

  @@index([placeId])
  @@map("place_faqs")
}

model SEOMeta {
  id              String   @id @default(cuid())
  placeId         String   @unique
  place           Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  title           String
  description     String
  canonicalPath   String   // e.g. "/hotel/speke-resort-munyonyo"
  ogImageUrl      String?
  structuredData  Json?    // pre-rendered JSON-LD override, optional — usually generated on the fly

  updatedAt       DateTime @updatedAt

  @@map("seo_meta")
}

// Precomputed proximity/category relationships — powers "Nearby" and
// "Similar Places" without a live geo-query on every page load.
model NearbyRelation {
  id           String   @id @default(cuid())
  fromPlaceId  String
  fromPlace    Place    @relation("NearbyFromPlace", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlaceId    String
  toPlace      Place    @relation("NearbyToPlace", fields: [toPlaceId], references: [id], onDelete: Cascade)

  distanceKm   Float?
  relationType String   @default("nearby") // "nearby" | "similar"
  rank         Int      @default(0)

  @@unique([fromPlaceId, toPlaceId, relationType])
  @@index([fromPlaceId, relationType, rank])
  @@map("nearby_relations")
}

// ---------------------------------------------------------------------------
// Ingestion / background pipeline
// ---------------------------------------------------------------------------

model IngestionBatch {
  id          String             @id @default(cuid())
  label       String             // e.g. "uganda-kampala-hotels-2026-07-20"
  country     String?
  category    PlaceCategory?
  status      IngestionRunStatus @default(RUNNING)

  totalFound     Int @default(0)
  totalInserted  Int @default(0)
  totalUpdated   Int @default(0)
  totalSkipped   Int @default(0)
  totalFailed    Int @default(0)

  startedAt   DateTime           @default(now())
  finishedAt  DateTime?

  logs        IngestionLog[]

  @@map("ingestion_batches")
}

model IngestionLog {
  id         String   @id @default(cuid())
  batchId    String
  batch      IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  placeId    String?
  place      Place?   @relation(fields: [placeId], references: [id])

  stage      String   // "discover" | "normalize" | "enrich" | "persist" | "queue-ai" | "revalidate"
  status     String   // "success" | "skipped" | "failed"
  message    String?  @db.Text

  createdAt  DateTime @default(now())

  @@index([batchId])
  @@map("ingestion_logs")
}

// ---------------------------------------------------------------------------
// Lightweight analytics — avoids depending on a third-party API for the
// admin dashboard's core metrics.
// ---------------------------------------------------------------------------

model SearchQueryLog {
  id        String   @id @default(cuid())
  query     String
  resultsCount Int
  placeId   String?  // set if the user clicked through to a specific place
  place     Place?   @relation(fields: [placeId], references: [id])
  createdAt DateTime @default(now())

  @@index([query])
  @@map("search_query_logs")
}

model PageViewLog {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([placeId, createdAt])
  @@map("page_view_logs")
}

// ============================================================================
// TikTok Content Automation
// Reuses Place directly via a foreign key rather than duplicating hotel/
// restaurant/attraction data. Since Place already unifies every content type
// under `category`, there's no polymorphic contentType field — eligibility
// and selection both just query Place with the right filters.
// ============================================================================

enum TikTokAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum TikTokPostStatus {
  PENDING_REVIEW // approvalRequired=true and not yet approved by an admin
  SCHEDULED      // approved (or auto-approved) and waiting for scheduledFor
  PUBLISHING     // publish attempt currently in flight
  PUBLISHED
  FAILED
  CANCELLED
}

enum TikTokMediaType {
  PHOTO_CAROUSEL // supported now — TikTok's Content Posting API photo endpoint
  VIDEO          // modeled for the future; no generator wired in yet
}

model TikTokAccount {
  id                String              @id @default(cuid())
  openId            String              @unique // TikTok's stable user identifier
  username          String?

  // Tokens are encrypted at rest with lib/tiktok/crypto.ts (AES-256-GCM)
  // before being written here — never store raw OAuth tokens in the DB.
  accessTokenEnc    String              @db.Text
  refreshTokenEnc   String              @db.Text
  scope             String              // space-separated granted scopes, e.g. "video.publish user.info.basic"
  expiresAt         DateTime
  refreshExpiresAt  DateTime?

  status            TikTokAccountStatus @default(ACTIVE)
  isAudited         Boolean             @default(false) // false = posts publish as SELF_ONLY only, see lib/tiktok/client.ts

  connectedAt       DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  settings          TikTokPostingSettings?
  posts             TikTokPost[]

  @@map("tiktok_accounts")
}

// Single-row configuration table (one row per connected account). Every
// behavior the project brief asks to be "configurable, not hard-coded"
// lives here, read fresh by the queue builder on every run.
model TikTokPostingSettings {
  id                     String        @id @default(cuid())
  accountId              String        @unique
  account                TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  dailyPostCount         Int      @default(5)
  minHotelPostsPerDay    Int      @default(2)
  autoPublish            Boolean  @default(false) // OFF by default — an admin opts in deliberately
  approvalRequired       Boolean  @default(true)

  cooldownDays           Int      @default(30) // minimum days before the same Place can be reposted

  // Posting windows as 24h "HH:mm" strings in the given IANA timezone —
  // the queue builder spreads dailyPostCount posts across these windows
  // rather than clustering them. Kept as JSON so window/count can change
  // without a migration.
  postingTimezone        String   @default("UTC")
  postingWindows         Json     @default("[\"08:00\",\"11:00\",\"14:00\",\"18:00\",\"21:00\"]")

  // Scoring weights (0-1) — see lib/tiktok/scoring.ts.
  scoringWeights         Json     @default("{\"popularity\":0.35,\"freshness\":0.2,\"imageQuality\":0.15,\"categoryDiversity\":0.15,\"geoDiversity\":0.15}")

  hashtagBaseTags        Json     @default("[\"Travel\",\"TravelTok\",\"Explore\"]")
  ctaVariants            Json     @default("[\"Discover more through the link in our bio.\",\"Explore more places through our website.\",\"Find your next destination — link in bio.\"]")

  updatedAt              DateTime @updatedAt

  @@map("tiktok_posting_settings")
}

// A curated library of tracks the operator has rights to use, standing in
// for "trending sound selection" — the public Content Posting API doesn't
// expose TikTok's trending sound library for programmatic attachment, so
// sound comes from whatever audio is baked into the uploaded file. Manually
// maintained, not scraped.
model TikTokTrack {
  id          String   @id @default(cuid())
  label       String   // e.g. "Upbeat Travel Loop A"
  fileUrl     String   // Cloudinary (or other) URL to the licensed audio file
  moodTags    Json     @default("[]") // e.g. ["upbeat","cinematic","chill"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  posts       TikTokPost[]

  @@map("tiktok_tracks")
}

model TikTokPost {
  id              String            @id @default(cuid())

  accountId       String
  account         TikTokAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  placeId         String
  place           Place             @relation(fields: [placeId], references: [id], onDelete: Cascade)

  status          TikTokPostStatus  @default(PENDING_REVIEW)
  mediaType       TikTokMediaType   @default(PHOTO_CAROUSEL)
  mediaUrls       Json              // snapshot of the Cloudinary URLs used, frozen at selection time

  trackId         String?
  track           TikTokTrack?      @relation(fields: [trackId], references: [id])

  caption         String            @db.Text
  hashtags        Json              // string[]
  ctaVariant      String?

  selectionScore  Float             // the score this Place got when chosen — feeds later analytics/tuning
  selectionReason Json?             // e.g. {"popularity":0.8,"trendingHotelSlot":true} — powers "why was it selected?"

  scheduledFor    DateTime
  publishedAt     DateTime?

  tiktokPublishId String?           // TikTok's publish_id / video id once published
  errorMessage    String?           @db.Text
  attemptCount    Int               @default(0)

  // Analytics — populated by a future metrics-refresh job, out of scope
  // for this pass (needs the TikTok Display/Analytics API wired in).
  views           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  profileVisits   Int?
  websiteClicks   Int?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  logs            TikTokPublishingLog[]

  @@index([status, scheduledFor])
  @@index([placeId])
  @@map("tiktok_posts")
}

model TikTokPublishingLog {
  id        String     @id @default(cuid())
  postId    String
  post      TikTokPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  event     String     // "queued" | "validation_failed" | "publish_attempt" | "publish_success" | "publish_failed" | "retried" | "cancelled"
  message   String?    @db.Text

  createdAt DateTime   @default(now())

  @@index([postId])
  @@map("tiktok_publishing_logs")
}
// ============================================================================
// Google Places integration
// Deliberately NOT part of the Place model's normal content flow. Google's
// current Places API policy only exempts place_id (indefinite) and
// coordinates (30 days) from storage restrictions — every other field
// (name, address, phone, rating, photos) must never be persisted from
// Google directly. GooglePlaceCandidate is a quarantine queue: an admin
// reviews and re-authors a candidate through the normal place editor before
// it ever becomes real, published HorizonSpot content in the Place table.
// ============================================================================

enum GoogleCandidateStatus {
  NEW
  PROMOTED   // an admin reviewed it and created/linked a real Place
  REJECTED   // an admin reviewed it and declined it
  EXPIRED    // never reviewed within the retention window — see cron/google-cleanup
}

model GooglePlaceCandidate {
  id              String                @id @default(cuid())
  googlePlaceId   String                @unique

  // Internal-only fields for the admin review queue — never rendered on any
  // public page. Treated as a draft label, not stored/redistributed content.
  displayNameRaw  String
  categoryGuess   PlaceCategory?
  latitude        Float
  longitude       Float
  rawTypes        Json                  // Google's `types` array, for debugging the category mapping

  source          String                @default("google-places-discovery") // "google-places-discovery" | "google-search-fallback"
  provider String @default("google") // "google" | "geoapify" — which API actually supplied this candidate
  regionKey       String?               // which region/query surfaced this, for observability

  status          GoogleCandidateStatus @default(NEW)
  promotedPlaceId String?               @unique
  promotedPlace   Place?                @relation(fields: [promotedPlaceId], references: [id])

  discoveredAt    DateTime              @default(now())
  expiresAt       DateTime              // discoveredAt + retention window — purged by cron/google-cleanup if still NEW
  reviewedAt      DateTime?

  @@index([status, expiresAt])
  @@map("google_place_candidates")
}

// Tracks Google Text Search calls made on behalf of live user searches, so
// the same normalized query doesn't trigger a fresh (billable) Google
// request within the cooldown window — the core API-cost control for the
// search fallback path.
model GoogleSearchLog {
  id              String   @id @default(cuid())
  normalizedQuery String   @unique
  resultCount     Int
  lastQueriedAt   DateTime @default(now())
  queryCount      Int      @default(1)

  @@map("google_search_logs")
}
// ============================================================================
// SEO Intelligence
// One model, not five (SEOPage/Opportunity/Recommendation collapsed into a
// single `kind`-discriminated table) — Section 30 explicitly asks not to
// split what one well-designed model can hold. Every score here is computed
// from real Place data on a schedule (jobs/seoIntelligence.ts), never live
// per-request (Section 27) and never fabricated (Section 35).
// ============================================================================

enum SeoInsightKind {
  OPPORTUNITY   // location x category page-worthiness evaluation
  HEALTH_CHECK  // per-place SEO completeness check
}

model SeoInsight {
  id             String         @id @default(cuid())
  kind           SeoInsightKind

  // OPPORTUNITY fields — null when kind = HEALTH_CHECK
  countryId      String?
  cityId         String?
  category       PlaceCategory?
  placeCount     Int?
  recommendation String?        // "CREATE" | "OPTIMIZE" | "MONITOR" | "DO_NOT_CREATE"

  // HEALTH_CHECK fields — null when kind = OPPORTUNITY
  placeId        String?
  place          Place?         @relation(fields: [placeId], references: [id], onDelete: Cascade)
  checks         Json?          // SeoHealthCheck[] — see lib/seo/health.ts

  score          Float          // 0-100 for both kinds
  computedAt     DateTime       @default(now())

  @@index([kind, score])
  @@index([placeId])
  @@map("seo_insights")
}
// ============================================================================
// Global Location Graph (Section 6)
// ============================================================================

enum LocationType {
  COUNTRY
  STATE
  PROVINCE
  REGION
  COUNTY
  DISTRICT
  CITY
  TOWN
  NEIGHBORHOOD
  ISLAND
  METRO_AREA
}

model Location {
  id             String       @id @default(cuid())
  type           LocationType
  name           String
  slug           String
  alternateNames Json?        // string[]
  countryCode    String?      // ISO 3166-1 alpha-2

  latitude       Float?
  longitude      Float?

  parentId       String?
  parent         Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       Location[]   @relation("LocationHierarchy")

  geonameId      Int?         @unique // external identity for re-import dedup — same role as googlePlaceId elsewhere

  createdAt      DateTime     @default(now())

  @@unique([countryCode, type, slug])
  @@index([parentId])
  @@index([type, countryCode])
  @@map("locations")
}

// ============================================================================
// Landmarks (Section 32 — PROXIMITY page type) — admin-curated, not a global
// import. This unblocks proximity pages ("hotels near X") immediately
// without waiting on the Location graph import.
// ============================================================================

model Landmark {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  type      String   // "airport" | "attraction" | "transit_hub" | "other" — free text, admin sets it, not a rigid enum
  latitude  Float
  longitude Float
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  cityId    String?
  city      City?    @relation(fields: [cityId], references: [id])
  radiusKm  Float    @default(10)
  createdAt DateTime @default(now())

  discoveryPages DiscoveryPage[]

  @@map("landmarks")
}

// ============================================================================
// Discovery Signals (Section 11) — batch-computed, never live per-request
// ============================================================================

model PlaceDiscoveryScore {
  id                String   @id @default(cuid())
  placeId           String   @unique
  place             Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  popularityScore   Float
  freshnessScore    Float
  completenessScore Float
  editorialScore    Float // real signal: 1.0 if Place.featured, else 0 — never fabricated
  discoveryScore    Float // popularity+freshness+completeness composite, editorial excluded on purpose
  horizonScore      Float // final combined score — default sort order on discovery pages

  computedAt        DateTime @default(now())

  @@index([horizonScore])
  @@map("place_discovery_scores")
}

// ============================================================================
// Discovery Pages (Sections 7, 8, 23, 24, 32) — materializes an opportunity
// into an actual indexable page. This IS the sitemap/canonical source of
// truth: only rows with status = INDEXABLE are ever linked publicly or
// included in the sitemap.
// ============================================================================

enum DiscoveryPageType {
  LOCATION_CATEGORY
  PROXIMITY
}

enum DiscoveryPageStatus {
  DRAFT      // quality gate passed, not yet public
  INDEXABLE  // live, in sitemap
  RETIRED    // quality dropped on recompute — deindexed, URL preserved (never deleted, avoids orphaning)
}

model DiscoveryPage {
  id           String              @id @default(cuid())
  pageType     DiscoveryPageType
  slug         String              @unique

  countryId    String?
  country      Country?            @relation(fields: [countryId], references: [id])
  cityId       String?
  city         City?               @relation(fields: [cityId], references: [id])
  landmarkId   String?
  landmark     Landmark?           @relation(fields: [landmarkId], references: [id])
  category     PlaceCategory

  status       DiscoveryPageStatus @default(DRAFT)
  qualityScore Float
  placeCount   Int

  title        String
  description  String

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, pageType])
  @@map("discovery_pages")
}

// ============================================================================
// Search Console integration (Sections 12, 13, 15)
// ============================================================================

model SearchConsoleAccount {
  id              String    @id @default(cuid())
  siteUrl         String    @unique
  accessTokenEnc  String    @db.Text
  refreshTokenEnc String    @db.Text
  expiresAt       DateTime
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?

  @@map("search_console_accounts")
}

model SearchPerformanceRecord {
  id              String   @id @default(cuid())
  query           String
  page            String
  country         String?
  device          String?
  date            DateTime
  impressions     Int
  clicks          Int
  ctr             Float
  averagePosition Float
  syncedAt        DateTime @default(now())

  @@unique([query, page, country, device, date])
  @@index([page, date])
  @@index([query])
  @@map("search_performance_records")
}

enum CtrOpportunityCategory {
  SNIPPET_PROBLEM
  RANKING_PROBLEM
  RANKING_OPPORTUNITY
  QUERY_MISMATCH
}

model CtrOpportunity {
  id              String                 @id @default(cuid())
  page            String
  query           String
  impressions     Int
  clicks          Int
  ctr             Float
  averagePosition Float
  category        CtrOpportunityCategory
  detectedAt      DateTime               @default(now())
  resolved        Boolean                @default(false)

  @@index([category, resolved])
  @@map("ctr_opportunities")
}

model SeoExperiment {
  id                String    @id @default(cuid())
  page              String
  titleBefore       String
  titleAfter        String
  descriptionBefore String?
  descriptionAfter  String?

  startedAt         DateTime  @default(now())
  endedAt           DateTime?

  impressionsBefore Int?
  clicksBefore      Int?
  ctrBefore         Float?
  positionBefore    Float?

  impressionsAfter  Int?
  clicksAfter       Int?
  ctrAfter          Float?
  positionAfter     Float?

  status            String    @default("RUNNING") // "RUNNING" | "COMPLETED" | "INCONCLUSIVE"
  verdict           String?   @db.Text

